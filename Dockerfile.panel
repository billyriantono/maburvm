# Build stage. Runs on the build machine and cross-compiles, so a multi-arch
# build (the release workflow) does not compile under emulation.
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS builder

RUN apk add --no-cache gcc musl-dev

WORKDIR /app

# Copy go mod files first for caching
COPY go.mod go.sum ./
RUN go mod download

# Targeted source copies required to build the panel and its dependencies.
# Avoid a broad `COPY . .` so host artifacts/secrets never enter the build
# context/layers (see .dockerignore). cmd/panel imports internal/ and the
# generated gRPC code under api/proto.
COPY cmd/ ./cmd/
COPY internal/ ./internal/
COPY api/ ./api/
COPY integrations/ ./integrations/

# Build the panel binary (static, no CGO)
# Stamped at build time because the image cannot discover it: the COPY lines
# above deliberately exclude .git, so Go's automatic VCS stamping finds nothing.
# Without this the panel cannot answer "which build am I?", which is the only way
# to confirm a deploy landed.
ARG GIT_COMMIT=""
ARG BUILD_TIME=""
ARG APP_VERSION=""
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build \
    -ldflags "-X github.com/maburvm/panel/internal/shared/buildinfo.Commit=${GIT_COMMIT} \
              -X github.com/maburvm/panel/internal/shared/buildinfo.BuildTime=${BUILD_TIME} \
              -X github.com/maburvm/panel/internal/shared/buildinfo.Version=${APP_VERSION}" \
    -o /app/bin/panel ./cmd/panel

# Node agent, built from the same source and stamp as the panel so the panel can
# push it to nodes (System settings -> Update). The agent links libvirt via cgo,
# so it needs glibc + libvirt headers; bookworm (glibc 2.36, libvirt 9.0) is older
# than every node's userland, so the binary runs on all of them. Do not move this
# to a newer base without checking the oldest node's glibc (`ldd --version`).
# Pinned to amd64: the cgo cross-compile below expects an amd64 build host, and
# a multi-arch panel image then carries one identical agent build.
FROM --platform=linux/amd64 golang:1.25-bookworm AS agent-builder
RUN apt-get update && apt-get install -y --no-install-recommends libvirt-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
COPY api/ ./api/
COPY integrations/ ./integrations/
ARG GIT_COMMIT=""
ARG BUILD_TIME=""
ARG APP_VERSION=""
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build \
    -ldflags "-X github.com/maburvm/panel/internal/shared/buildinfo.Commit=${GIT_COMMIT} \
              -X github.com/maburvm/panel/internal/shared/buildinfo.BuildTime=${BUILD_TIME} \
              -X github.com/maburvm/panel/internal/shared/buildinfo.Version=${APP_VERSION}" \
    -o /app/bin/linux/agent-amd64 ./cmd/agent
# arm64 nodes: off unless asked for (--build-arg AGENT_ARM64=1), so an image for
# amd64-only fleets builds exactly as before. Cross-compiled against Debian's
# arm64 libvirt; the node still test-runs it before swapping it in.
ARG AGENT_ARM64=""
RUN if [ "$AGENT_ARM64" = "1" ]; then \
      dpkg --add-architecture arm64 && apt-get update \
      && apt-get install -y --no-install-recommends gcc-aarch64-linux-gnu libc6-dev-arm64-cross libvirt-dev:arm64 \
      && PKG_CONFIG_LIBDIR=/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig \
         CGO_ENABLED=1 GOOS=linux GOARCH=arm64 CC=aarch64-linux-gnu-gcc go build \
         -ldflags "-X github.com/maburvm/panel/internal/shared/buildinfo.Commit=${GIT_COMMIT} \
                   -X github.com/maburvm/panel/internal/shared/buildinfo.BuildTime=${BUILD_TIME} \
                   -X github.com/maburvm/panel/internal/shared/buildinfo.Version=${APP_VERSION}" \
         -o /app/bin/linux/agent-arm64 ./cmd/agent; \
    fi

# The agent binaries alone: `docker buildx build --target agent-bin --output
# type=local,dest=DIR .` is how the release workflow publishes them.
FROM scratch AS agent-bin
COPY --from=agent-builder /app/bin/linux/ /

# Runtime stage
FROM alpine:3.24

# su-exec lets us drop from root to the unprivileged user after fixing volume
# ownership at startup (see docker/panel-entrypoint.sh).
RUN apk add --no-cache ca-certificates tzdata su-exec

# Create an unprivileged user. The named volume mounted at /data is owned by
# root when first created; the entrypoint chowns it to this UID at boot.
RUN addgroup -S -g 10001 maburvm \
    && adduser -S -D -H -u 10001 -G maburvm maburvm

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/bin/panel ./panel
# Default AGENT_BINARY_DIR (bin/linux, relative to WORKDIR): agent-amd64, and
# agent-arm64 when it was built.
COPY --from=agent-builder /app/bin/linux/ ./bin/linux/
# Offline signatures for those binaries (agent-<arch>.sig), when the release
# workflow signed them; the directory is otherwise empty.
COPY docker/agent-sigs/ ./bin/linux/

# Copy migrations (panel reads these at runtime)
COPY internal/shared/db/migrations ./migrations

# Drop-in entrypoint that fixes data-dir ownership then execs as maburvm.
COPY docker/panel-entrypoint.sh /app/entrypoint.sh
RUN chmod 0755 /app/entrypoint.sh

# The panel writes crypto secrets / persistence under /data. Pre-create it owned
# by maburvm so a fresh volume is usable even before the entrypoint re-chowns it.
RUN mkdir -p /data && chown -R maburvm:maburvm /data

# NOTE: No `USER` directive here on purpose. The entrypoint MUST start as root so
# it can fix /data ownership and read the host-provided secret files before
# dropping privileges to maburvm via su-exec (see docker/panel-entrypoint.sh).

EXPOSE 8080

ENTRYPOINT ["/app/entrypoint.sh"]
