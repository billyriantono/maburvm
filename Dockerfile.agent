# Build stage
FROM golang:1.25-alpine AS builder

RUN apk add --no-cache gcc musl-dev libvirt-dev

WORKDIR /app

# Copy go mod files first for caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the agent binary (requires libvirt)
RUN CGO_ENABLED=1 GOOS=linux go build -o /app/bin/agent ./cmd/agent

# Runtime stage
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata libvirt

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/bin/agent .

EXPOSE 50051

ENTRYPOINT ["./agent"]
