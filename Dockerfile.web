# Dependencies stage
FROM node:22.23.1-alpine3.24 AS deps

WORKDIR /app

COPY web/package.json web/package-lock.json ./
RUN npm ci

# Build stage
FROM node:22.23.1-alpine3.24 AS builder

WORKDIR /app

# Build-time API base URL. Consumed by next.config.js rewrites() at `next build`
# time and baked into the generated route manifest. It is intentionally NOT a
# NEXT_PUBLIC_* variable, so the panel hostname never reaches client bundles.
#
# ARG default is a LOCAL-ONLY convenience for plain `docker build` / dev. A real
# production image MUST NOT bake localhost: production callers (Compose,
# Makefile, README) pass API_BASE_URL explicitly AND set ENFORCE_API_BASE_URL=1,
# which fails the build if it is empty or still localhost.
ARG API_BASE_URL=http://localhost:8080
ARG ENFORCE_API_BASE_URL=
ENV API_BASE_URL=$API_BASE_URL

# Production gate: refuse empty or localhost values when enforcement is on.
RUN if [ -n "$ENFORCE_API_BASE_URL" ]; then \
      if [ -z "$API_BASE_URL" ]; then \
        echo "API_BASE_URL is required for production builds" >&2; exit 1; \
      fi; \
      case "$API_BASE_URL" in \
        *localhost*|*127.0.0.1*) \
          echo "API_BASE_URL must not be localhost for production builds (got $API_BASE_URL)" >&2; exit 1 ;; \
      esac; \
    fi

COPY --from=deps /app/node_modules ./node_modules
COPY web/ .

ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# Runtime stage
FROM node:22.23.1-alpine3.24 AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
