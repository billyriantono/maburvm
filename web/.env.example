# Frontend Environment Configuration
# Copy this file to .env.local and update values for your environment

# =============================================================================
# API Backend Configuration
# =============================================================================
# Alamat backend API (server-side). Dipakai oleh next.config.js rewrites() saat
# `next build` (BUILD-TIME, dibakar ke route manifest) DAN oleh route server
# seperti /api/vm-events saat runtime server.
# Saat development: http://localhost:8080
# Saat production (Compose): http://panel:8080  (di-pass via build arg/runtime)
# Catatan: ini BUKAN variabel NEXT_PUBLIC_* — nilai panel tidak boleh masuk ke
# bundle browser agar panggilan tetap same-origin.
API_BASE_URL=http://localhost:8080

# Public override ke browser TIDAK didukung / dihapus. Aplikasi web memanggil
# backend secara same-origin via proxy /api dan /ws (lihat next.config.js), jadi
# hostname panel tidak boleh di-expose ke client. Baris di bawah sengaja
# dinonaktifkan dan tidak lagi digunakan oleh kode:
# NEXT_PUBLIC_API_URL=https://api.maburvm.com
