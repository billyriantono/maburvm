# Frontend Environment Configuration
# Copy this file to .env.local and update values for your environment

# =============================================================================
# API Backend Configuration
# =============================================================================
# Alamat backend API (untuk server-side requests dan proxy)
# Saat development: http://localhost:8089
# Saat production: http://ip-atau-domain-backend:port
API_BASE_URL=http://localhost:8089

# Alamat API yang diexpose ke browser (opsional, default sama dengan API_BASE_URL)
# Gunakan ini kalau frontend dan backend di server berbeda
# NEXT_PUBLIC_API_URL=https://api.maburvm.com
