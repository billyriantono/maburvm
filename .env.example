# MaburVM Development Environment Variables
# Copy this file to .env and update the values for your local environment

# =============================================================================
# PostgreSQL Configuration
# =============================================================================
POSTGRES_USER=maburvm
POSTGRES_PASSWORD=changeme
POSTGRES_DB=maburvm
POSTGRES_PORT=5432

# =============================================================================
# MinIO (S3-Compatible Storage) Configuration
# =============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# MinIO Bucket Configuration
MINIO_BUCKET_NAME=maburvm-backups

# =============================================================================
# Mailpit (Email Testing) Configuration
# =============================================================================
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# =============================================================================
# Application Configuration
# =============================================================================
# Backend API
APP_HOST=0.0.0.0
APP_PORT=8080

# Database URL (for application)
DATABASE_URL=postgres://maburvm:changeme@localhost:5432/maburvm?sslmode=disable

# JWT Secret (use a strong random string in production)
JWT_SECRET=your-jwt-secret-change-in-production

# =============================================================================
# MinIO/S3 Configuration for Application
# =============================================================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=maburvm-backups
S3_REGION=us-east-1

# =============================================================================
# Libvirt/QEMU Configuration (for Node Agent)
# =============================================================================
LIBVIRT_URI=qemu:///system
LIBVIRT_USERNAME=
LIBVIRT_PASSWORD=

# =============================================================================
# Optional: External Services
# =============================================================================
# If using external SMTP for development emails
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=

# =============================================================================
# Optional: Billing API Webhook
# =============================================================================
# BILLING_WEBHOOK_SECRET=your-webhook-secret