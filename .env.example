# MaburVM Development Environment Variables
# Copy this file to .env and update the values for your local environment

# =============================================================================
# Database Configuration
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=maburvm
DB_SSL_MODE=disable

# =============================================================================
# Server Configuration
# =============================================================================
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# Crypto secrets (OPTIONAL)
# =============================================================================
# Leave these unset for a normal single-node install: the panel generates strong
# random keys on first boot and persists them under MABURVM_DATA_DIR (default
# ./data) so they survive restarts. Set them ONLY for multi-instance deployments
# (all instances must share the same values) or to pin secrets to an external
# secret manager. AES_KEY, if set, must be EXACTLY 32 bytes.
# MABURVM_DATA_DIR=./data
# JWT_SECRET_KEY=
# AES_KEY=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# =============================================================================
# Agent Configuration
# =============================================================================
AGENT_GRPC_PORT=50051
AGENT_HEARTBEAT_INTERVAL=30s

# =============================================================================
# S3 Configuration
# =============================================================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=maburvm-backups
S3_REGION=us-east-1

# =============================================================================
# VNC Configuration
# =============================================================================
VNC_TOKEN_TTL=5m
VNC_PROXY_TIMEOUT=10s

# =============================================================================
# Optional: External Services
# =============================================================================
# If using external SMTP for development emails
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=

# =============================================================================
# Optional: Billing API Webhook
# =============================================================================
# BILLING_WEBHOOK_SECRET=your-webhook-secret
